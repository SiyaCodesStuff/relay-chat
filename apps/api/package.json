{
  "name": "@relay-chat/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:integration": "node --env-file-if-exists=../../.env --import tsx ../../node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "node --env-file-if-exists=../../.env --import tsx src/db/migrate.ts dev",
    "db:migrate:test": "node --env-file-if-exists=../../.env --import tsx src/db/migrate.ts test"
  },
  "dependencies": {
    "@relay-chat/shared": "0.1.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "^0.45.1",
    "connect-redis": "^9.0.0",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-session": "^1.18.2",
    "pg": "^8.23.1",
    "redis": "^5.10.0",
    "socket.io": "^4.8.1",
    "ulid": "^3.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15"
  }
}
